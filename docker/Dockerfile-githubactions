FROM ubuntu:24.04

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Install python 3.13
RUN uv python install 3.13

# Install system dependencies
RUN apt update && apt install -y default-jre
COPY Aptfile .
RUN apt update
RUN apt install -y --no-install-recommends $(cat Aptfile)

# Install Python deps
COPY pyproject.toml .
COPY uv.lock .
RUN uv sync --locked

